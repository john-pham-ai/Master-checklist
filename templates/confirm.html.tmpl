<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Smoke Test Submitted</title>
<link rel="stylesheet" href="/static/style.css">
</head>
<body>
<header class="topbar">
  <h1>Smoke Test Submitted</h1>
</header>
<div class="card" style="max-width:640px;margin:2rem auto;">
  <p>Confluence page created: <a href="{{.PageURL}}" target="_blank" rel="noopener">{{.PageURL}}</a></p>
  <p id="gatekeeper-status">Opening Gatekeeper in a new window&hellip;</p>
  <p><a id="gatekeeper-link" class="submit-btn" style="display:inline-block;text-decoration:none;text-align:center;" href="{{.GatekeeperURL}}" target="_blank" rel="noopener">Continue to Gatekeeper &rarr;</a></p>
  <p><a href="/">Back to checklist</a></p>
</div>
<script src="/static/app.js"></script>
<script>
  (function () {
    var popup = window.open({{.GatekeeperURL}}, "_blank", "noopener");
    var status = document.getElementById("gatekeeper-status");
    if (!popup) {
      status.textContent = "Your browser blocked the Gatekeeper popup — use the button below instead.";
    } else {
      status.hidden = true;
    }
  })();
</script>
</body>
</html>
