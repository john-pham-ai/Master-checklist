<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AD Smoke Test Checklist</title>
<link rel="stylesheet" href="/static/style.css?v={{.AssetVersion}}">
</head>
<body>
<header class="topbar">
  <h1 data-i18n="title">AD Smoke Test Checklist</h1>
  <div class="controls">
    <a class="btn-link" href="/feedback" data-i18n="help_button">Help / Feedback</a>
    <button id="theme-toggle" type="button">Light mode</button>
    <select id="lang-select">
      <option value="en">EN</option>
      <option value="ja">JA</option>
    </select>
  </div>
</header>

<form id="checklist-form" method="post" action="/submit" enctype="multipart/form-data">
  <section class="card" id="media-setup-card">
    <h2 data-i18n="section_media_setup">Screenshots &amp; video clips</h2>
    <p class="muted small" data-i18n="media_setup_intro">Each check below can take pasted screenshots and video clips, which are attached to the Confluence page. Screen/webcam recording needs one-time browser permission — set it up here so it's ready before you start testing.</p>
    <button type="button" id="media-setup-btn" data-i18n="media_setup_btn">🔧 Enable screen &amp; webcam recording</button>
    <p id="media-setup-status" class="muted small" hidden></p>
  </section>

  <section class="card" id="diff-card">
    <h2 data-i18n="section_diff">What changed since the previous build</h2>
    <div class="grid">
      <label>
        <span data-i18n="field_diff_base">Compare against</span>
        <select name="diff_base" id="diff-base" disabled>
          <option value="" data-i18n="tags_loading">Loading builds…</option>
        </select>
      </label>
      <label>
        <span>&nbsp;</span>
        <span class="diff-actions">
          <button type="button" id="diff-reload" data-i18n="diff_reload">Reload changes</button>
          <a id="diff-compare-link" class="field-hint" href="#" target="_blank" rel="noopener" hidden data-i18n="diff_compare_link">Full list on GitHub</a>
        </span>
      </label>
    </div>
    <p id="diff-status" class="muted small">The latest build of the selected test type is pre-selected and compared with the one before it. You can change either dropdown.</p>
    <div id="diff-results"></div>
    <label class="stack">
      <span data-i18n="field_diff_notes">Notes on the changes (optional — included on the Confluence page)</span>
      <textarea name="diff_notes" id="diff-notes" rows="3" data-i18n-placeholder="diff_notes_placeholder" placeholder="Anything to call out for this build?"></textarea>
    </label>
    <input type="hidden" name="diff_json" id="diff-json">
  </section>

  <section class="card">
    <h2 data-i18n="section_run_info">Run Info</h2>
    <div class="grid">
      <label>
        <span data-i18n="field_test_type">Test Type</span>
        <select name="test_type" id="test-type-select" required>
          <option value="master" selected data-i18n="test_type_master">Master Testing</option>
          <option value="candidate" data-i18n="test_type_candidate">Candidate Testing</option>
        </select>
      </label>
      <label>
        <span data-i18n="field_tag">Tag</span>
        <select name="tag" id="tag-select" required disabled>
          <option value="" data-i18n="tags_loading">Loading builds…</option>
        </select>
      </label>
      <label>
        <span data-i18n="field_date">Date</span>
        <input type="date" name="date" value="{{.Today}}" required>
      </label>
      <label>
        <span data-i18n="field_vehicle">Vehicle</span>
        <input type="text" name="vehicle" list="vehicle-suggestions" autocomplete="off" inputmode="numeric" required>
        <datalist id="vehicle-suggestions">{{range .Vehicles}}<option value="{{.}}"></option>{{end}}</datalist>
      </label>
      <label>
        <span data-i18n="field_test_engineer">Test Engineer</span>
        <input type="text" name="test_engineer" list="engineer-suggestions" autocomplete="off" value="{{.CurrentEngineer}}" required>
        <datalist id="engineer-suggestions"></datalist>
      </label>
      <label>
        <span data-i18n="field_commit_hash">Commit Hash</span>
        <input type="text" name="commit_hash" required>
      </label>
      <label>
        <span data-i18n="field_slack_thread">Slack Thread</span>
        <a id="slack-channel-hint" href="https://grid-appliedint.enterprise.slack.com/archives/C0B1L8F6NUX" data-master-href="https://grid-appliedint.enterprise.slack.com/archives/C0B1L8F6NUX" data-candidate-href="https://grid-appliedint.enterprise.slack.com/archives/C08S18TSGCE" target="_blank" rel="noopener" class="field-hint" data-i18n="slack_channel_hint">Smoke test Slack channel</a>
        <input type="url" name="slack_thread" placeholder="https://...">
      </label>
      <label>
        <span data-i18n="field_recording_link">Recording (Google Drive link)</span>
        <a href="https://drive.google.com/drive/folders/0AA2bNJa-T_ApUk9PVA" target="_blank" rel="noopener" class="field-hint" data-i18n="drive_folder_hint">Shared Drive folder</a>
        <input type="url" name="recording_link" placeholder="https://drive.google.com/...">
      </label>
      <label>
        <span data-i18n="field_run_id">Run ID</span>
        <input type="text" name="run_id" required>
      </label>
      <label>
        <span data-i18n="field_overall_result">Overall Result</span>
        <select name="overall_result" required>
          <option value="pass" data-i18n="result_pass">Pass</option>
          <option value="fail" data-i18n="result_fail">Fail</option>
          <option value="partial" data-i18n="result_partial">Partial</option>
        </select>
      </label>
    </div>
  </section>

  <section class="card">
    <h2 data-i18n="section_preflight">Preflight Checks</h2>
    {{range .PreflightChecks}}{{template "check_item" .}}{{end}}
  </section>

  <section class="card">
    <h2 data-i18n="section_engagement">Engagement Checks</h2>
    {{range .EngagementChecks}}{{template "check_item" .}}{{end}}
  </section>

  <section class="card">
    <h2 data-i18n="section_disengagement">Disengagement Checks</h2>
    <div class="grid">
      <label>
        <span data-i18n="field_disengagement_run_id">Run ID</span>
        <input type="text" name="disengagement_run_id">
      </label>
      <label>
        <span data-i18n="field_disengagement_closed_loop_run_id">Closed Loop Run ID</span>
        <input type="text" name="disengagement_closed_loop_run_id">
      </label>
    </div>
    {{range .DisengagementChecks}}{{template "check_item" .}}{{end}}
  </section>

  <button type="submit" class="submit-btn" data-i18n="submit">Submit &amp; Create Confluence Page</button>
</form>

<footer>
  <a href="{{.GithubURL}}" target="_blank" rel="noopener" data-i18n="readme_link">README / Source</a>
</footer>

<script src="/static/app.js?v={{.AssetVersion}}"></script>
<script src="/static/media.js?v={{.AssetVersion}}"></script>
</body>
</html>

{{define "check_item"}}
<div class="check-item">
  <div class="check-row">
    <span class="check-label">{{.Label}}</span>
    <span class="check-radios">
      <label><input type="radio" name="result_{{.Key}}" value="pass" required> <span data-i18n="result_pass">Pass</span></label>
      <label><input type="radio" name="result_{{.Key}}" value="fail"> <span data-i18n="result_fail">Fail</span></label>
      <label><input type="radio" name="result_{{.Key}}" value="na"> <span data-i18n="result_na">N/A</span></label>
    </span>
    <input type="text" name="notes_{{.Key}}" class="notes" data-i18n-placeholder="notes_placeholder" placeholder="Notes">
  </div>
  <details class="check-help">
    <summary data-i18n="check_help_summary">How to verify · Pass/Fail criteria</summary>
    <p><strong data-i18n="check_help_verify_label">How to verify:</strong> <span data-i18n="check_{{.Key}}_verify">{{.Verify}}</span></p>
    <p><strong data-i18n="check_help_pass_label">Pass:</strong> <span data-i18n="check_{{.Key}}_pass">{{.Pass}}</span></p>
    <p><strong data-i18n="check_help_fail_label">Fail:</strong> <span data-i18n="check_{{.Key}}_fail">{{.Fail}}</span></p>
  </details>
  <div class="check-media" data-check-key="{{.Key}}">
    <div class="check-media-actions">
      <button type="button" class="media-btn media-btn-shot" data-i18n="media_btn_screenshot">📋 Paste / attach screenshot</button>
      <button type="button" class="media-btn media-btn-screen" data-i18n="media_btn_record_screen">🖥️ Record screen</button>
      <button type="button" class="media-btn media-btn-cam" data-i18n="media_btn_record_cam">🎥 Record webcam</button>
      <button type="button" class="media-btn media-btn-video" data-i18n="media_btn_attach_video">📎 Attach video file</button>
    </div>
    <p class="media-status muted small" hidden></p>
    <div class="media-list"></div>
    <input type="file" name="media_screenshot_{{.Key}}" class="media-input-shot" accept="image/*" multiple hidden>
    <input type="file" name="media_video_{{.Key}}" class="media-input-video" accept="video/*" multiple hidden>
  </div>
</div>
{{end}}
